{
  "group/audio": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 120,
      "children-class": "audio",
      "transition-left-to-right": false
    },
    "modules": [
      "pulseaudio",
      "pulseaudio/slider"
    ]
  },
  "niri/workspaces": {
    "on-click": "activate",
    "format": "<span size='15pt'>\u200b</span><span size='15pt' rise='-1536'>\u200b</span>{icon}",
    "format-icons": {
      "default": "󰄰",
      "active": "󰄯"
    }
  },
  "cffi/niri-windows": {
    "module_path": "__WAYBAR_MODULE_DIR__/waybar-niri-windows.so",
    "options": {
      "mode": "graphical",
      "minimum-size": 3,
      "spacing": 1,
      "column-borders": 2,
      "floating-borders": 2,
      "on-tile-click": "FocusWindow",
      "on-tile-middle-click": "CloseWindow",
      "on-tile-right-click": ""
    }
  },
  "cpu": {
    "format": "<span size='15pt'>\u200b</span><span size='15pt' rise='-1536'>\u200b</span><span size='15pt' rise='-1536'>󰬊󰬗󰬜</span> {usage}%",
    "interval": 1,
    "states": {
      "warning": 50,
      "critical": 80
    },
    "tooltip": true,
    "tooltip-format": "CPU: {usage}%  ·  {avg_frequency} GHz",
    "on-click": "ghostty -e btop"
  },
  "memory": {
    "format": "<span size='15pt'>\u200b</span><span size='15pt' rise='-1536'>\u200b</span><span size='15pt' rise='-1536'>󰬙󰬈󰬔</span> {used:0.1f}G",
    "interval": 2,
    "states": {
      "warning": 75,
      "critical": 90
    },
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.1f} / {total:0.1f} GiB  ·  占用 {percentage}%",
    "on-click": "ghostty -e btop"
  },
  "temperature#cpu": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "interval": 2,
    "warning-threshold": 75,
    "critical-threshold": 88,
    "format": "<span size='15pt'>\u200b</span><span size='15pt' rise='-1536'>\u200b</span>{temperatureC}°C",
    "tooltip": true,
    "tooltip-format": "CPU Package (i7-12700KF): {temperatureC}°C"
  },
  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu.sh util",
    "return-type": "json",
    "interval": 2,
    "tooltip": true
  },
  "custom/gpu-temp": {
    "exec": "~/.config/waybar/scripts/gpu.sh temp",
    "return-type": "json",
    "interval": 2,
    "tooltip": true
  },
  "custom/ssd": {
    "exec": "~/.config/waybar/scripts/nvme-temp.sh",
    "return-type": "json",
    "interval": 5,
    "tooltip": true
  },
  "clock": {
    "interval": 1,
    "format": "<span size='15pt'>\u200b</span><span size='15pt' rise='-1536'>\u200b</span><span foreground='#c678dd'>{0:%m月%d日}</span> <span foreground='#61afef'>{0:%H:%M}</span>",
    "format-alt": "{0:%d.%m.%y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },
  "mpris": {
    "format": "<span size='15pt'>\u200b</span><span size='15pt' rise='-1536'>\u200b</span><span size='14pt'>󰐎</span>",
    "interval": 1,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "tooltip": true,
    "tooltip-format": "{title}"
  },
  "tray": {
    "spacing": 10,
    "reverse-direction": true,
    "icon-size": 20,
    "show-passive-items": false
  },
  "privacy": {
    "icon-size": 14,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": false
      }
    ],
    "ignore": [
      {
        "type": "screenshare",
        "name": "obs"
      }
    ]
  },
  "bluetooth": {
    "format": "<span size='15pt'>\u200b</span><span size='15pt' rise='-1536'>\u200b</span>{icon}",
    "format-connected": "<span size='15pt'>\u200b</span><span size='15pt' rise='-1536'>\u200b</span>{icon} {num_connections}",
    "format-icons": {
      "connected": "<span size='14pt'>󰂱</span>",
      "on": "<span size='14pt'>󰂯</span>",
      "off": "<span size='14pt'>󰂲</span>",
      "disabled": "<span size='14pt'>󰂲</span>",
      "no-controller": "<span size='14pt'>󰂲</span>",
      "default": "<span size='14pt'>󰂯</span>"
    },
    "interval": 5,
    "tooltip": true,
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} 个已连接\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "ghostty -e bluetuith",
    "on-click-right": "bluetoothctl power toggle"
  },
  "network": {
    "format-icons": {
      "wifi": [
        "<span size='12pt'>󰤯</span>",
        "<span size='12pt'>󰤟</span>",
        "<span size='12pt'>󰤢</span>",
        "<span size='12pt'>󰤥</span>",
        "<span size='12pt'>󰤨</span>"
      ],
      "ethernet": "<span size='12pt'>󰈀</span>",
      "disabled": "<span size='12pt'>󰤭</span>",
      "disconnected": "<span size='12pt'>󰤩</span>"
    },
    "format-wifi": "<span size='15pt'>\u200b</span><span size='15pt' rise='-1536'>\u200b</span><span alpha='75%'>{ipaddr}</span> {icon}",
    "format-ethernet": "<span size='15pt'>\u200b</span><span size='15pt' rise='-1536'>\u200b</span><span alpha='75%'>{ipaddr}</span> {icon}",
    "format-disconnected": "<span size='15pt'>\u200b</span><span size='15pt' rise='-1536'>\u200b</span>{icon}",
    "format-disabled": "<span size='15pt'>\u200b</span><span size='15pt' rise='-1536'>\u200b</span>{icon}",
    "interval": 5,
    "tooltip-format": "{essid}\t{gwaddr}",
    "on-click": "rfkill toggle wifi",
    "on-click-right": "nm-connection-editor",
    "tooltip": true,
    "max-length": 20
  },
  "pulseaudio#microphone": {
    "format": "<span size='15pt'>\u200b</span><span size='15pt' rise='-1536'>\u200b</span>{format_source}",
    "format-source": "<span size='14pt'>󰍬</span>",
    "format-source-muted": "<span size='14pt'>󰍭</span>",
    "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "on-click-right": "pavucontrol -t 4",
    "tooltip": false
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },
  "pulseaudio": {
    "interval": 1,
    "format": "<span size='15pt'>\u200b</span><span size='15pt' rise='-1536'>\u200b</span>{icon}",
    "format-icons": [
      "<span size='14pt'>󰕿</span>",
      "<span size='14pt'>󰖀</span>",
      "<span size='14pt'>󰕾</span>"
    ],
    "format-muted": "<span size='15pt'>\u200b</span><span size='15pt' rise='-1536'>\u200b</span><span size='14pt'>󰝟</span>",
    "on-click-right": "pavucontrol -t 3",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "reverse-scrolling": true,
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%\n{desc}",
    "ignored-sinks": [
      "Easy Effects Sink"
    ]
  }
}
