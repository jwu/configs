[user]
	email = karasaya@gmail.com
	name = Johnny Wu
[init]
	defaultBranch = main
[core]
  pager = delta
  quotepath = false
[interactive]
  diffFilter = delta --color-only
[i18n]
  logOutputEncoding = utf-8
  commitEncoding = utf-8
[delta]
  navigate = true
  light = false
  line-numbers = true
  side-by-side = true
  syntax-theme = OneHalfDark
